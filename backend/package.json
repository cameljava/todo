{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "(trap 'kill 0' SIGINT EXIT; npx tsc --watch & node --watch dist/server.js)",
    "build": "tsc",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "clean": "rimraf dist node_modules",
    "docker:build": "docker build -t todo-api .",
    "docker:run": "docker run -p 3000:3000 --env-file .env todo-api",
    "docker:dev": "docker-compose up --build",
    "docker:dev:detached": "docker-compose up --build -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f todo-api",
    "docker:clean": "docker-compose down -v --rmi all"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.682.0",
    "@aws-sdk/client-dynamodb": "^3.682.0",
    "@aws-sdk/lib-dynamodb": "^3.682.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "node-fetch": "^3.3.2"
  }
}
