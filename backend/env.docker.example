# AWS Configuration
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=todo-app-dev-todos
# For local development with DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito Configuration
COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id

# Application Configuration
# NODE_ENV controls JWT signature verification:
# - "production" or "prod": Full JWT signature verification against AWS Cognito JWKS
# - Other values (development, test, etc.): JWT decoding without signature verification
NODE_ENV=production
PORT=3000

# For Docker Compose
COMPOSE_PROJECT_NAME=todo-app 