# Environment Configuration
NODE_ENV=development

# AWS Configuration
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=todo-app-dev-todos
DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito Configuration
COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate Limiting Configuration
# Global rate limiting (applies to all endpoints)
RATE_LIMIT_MAX=50                    # Maximum requests per time window
RATE_LIMIT_WINDOW=1 minute           # Time window for global rate limiting

# Authentication rate limiting (stricter limits for auth operations)
RATE_LIMIT_AUTH_MAX=5                # Maximum auth requests per time window
RATE_LIMIT_AUTH_WINDOW=1 minute      # Time window for auth rate limiting

# Rate limiting headers (include rate limit info in response headers)
RATE_LIMIT_HEADERS_ENABLED=true     # Set to 'false' to disable headers

# Server Configuration
PORT=3000 

# Local Development Only
# DYNAMODB_ENDPOINT=http://localhost:8000

# Rate Limiting Configuration
# RATE_LIMIT_MAX=100
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_HEADERS_ENABLED=true

# JWT Verification (for production, leave empty for development)
# JWT_VERIFICATION_MODE=local

# Health Check Configuration
# HEALTH_CHECK_TIMEOUT=5000 